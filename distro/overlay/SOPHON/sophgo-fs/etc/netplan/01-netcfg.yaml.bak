network:
        version: 2
        renderer: networkd
        ethernets:
                eth0:
                        dhcp4: no
                        addresses: [192.168.1.20/24]
                        nameservers:
                                addresses: [8.8.8.8]
                        routes:
                                - to: default
                                  via: 192.168.1.254
                                  metric: 200
                        optional: yes
                eth1:
                        dhcp4: no
                        addresses: [172.168.1.20/24]
                        nameservers:
                                addresses: [8.8.8.8]
                        routes:
                                - to: default
                                  via: 172.168.1.254
                                  metric: 100
                        optional: yes
