#!/bin/bash

if [ $# -lt 1   ] ; then
    echo "eg: bm_set_ip_auto eth0"
    exit -1
fi


device=$1


is_ubuntu=$(cat /etc/os-release | grep Ubuntu |wc -l)
is_kylinos=$(cat /etc/os-release | grep kylinos |wc -l)


if [ $is_ubuntu -gt 1 ];then
	echo "ubuntu"
        device_path="/etc/netplan/01-netcfg.yaml"
        #device_path="01-netcfg.yaml"

        # Build the whole new file content in a local temp file and swap it into
        # place with a single atomic "mv" at the end, instead of writing straight
        # to the live netplan file line by line -- an incremental-append there
        # leaves the file syntactically incomplete for the whole duration of the
        # script, and netplan's own file-change watcher can catch it mid-write and
        # fail to parse it. A temp file + atomic swap means any watcher only ever
        # sees the complete old file or the complete new one.
        tmp_path=$(mktemp)

        # Strip any existing config block for this device by indentation, not by a
        # fixed line-count guess (see bm_set_ip for why the old fixed-offset scan
        # could leave duplicate "$device:" blocks behind and break later grep/arith).
        awk -v dev="${device}:" '
                {
                        line = $0
                        content = line
                        sub(/^[ \t]*/, "", content)
                        match(line, /^[ \t]*/)
                        indent = RLENGTH
                        if (skip && indent <= dev_indent) { skip = 0 }
                        if (!skip && content == dev) { skip = 1; dev_indent = indent; next }
                        if (skip) next
                        print line
                }
        ' "$device_path" > "$tmp_path"

        echo "add network config"
        {
                echo "                ${device}:"
                echo "                        dhcp4: yes"
                echo "                        addresses: []"
                echo "                        dhcp-identifier: mac"
                echo "                        optional: yes"
        } | tee -a "$tmp_path"

        sudo cp "$tmp_path" "${device_path}.new"
        sudo chmod 600 "${device_path}.new"
        sudo mv "${device_path}.new" "$device_path"
        rm -f "$tmp_path"
	sudo sync
	sudo netplan apply


else
	if [ $is_kylinos -gt 1 ];then
		echo "kylin"
		exist=$(nmcli con | grep "static-${device}" | wc -l)
		if [ "$exist" -gt 0 ]; then
			nmcli con delete "static-${device}"
		fi
		nmcli con add type ethernet con-name "static-${device}" ifname ${device} ipv4.method auto
		nmcli connection modify "static-${device}" connection.autoconnect yes
		nmcli con up "static-${device}"
	else

		echo "debian"
		sudo rm -rf /etc/network/interfaces.d/$device
		sync
		sudo ip addr flush dev eth0
		sudo service networking restart
		sudo systemctl restart NetworkManager
	fi
fi
