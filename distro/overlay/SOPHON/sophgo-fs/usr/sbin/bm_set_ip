#!/bin/bash

# restoring default netplan configuration
restore_netplan() {
	NETPLAN_FILE="/etc/netplan/01-netcfg.yaml"
	DEFAULT_FILE="/etc/netplan/01-netcfg.yaml.bak"

    if [ -f "$DEFAULT_FILE" ]; then
        echo "Restoring default netplan configuration..."
        sudo cp "$DEFAULT_FILE" "$NETPLAN_FILE"
		sudo sync
        sudo netplan apply
        echo "Default netplan configuration restored."
    else
        echo "No found. Cannot restore default configuration."
    fi
}

if [ $1 == "default" ]; then
	restore_netplan
	exit 0
else
	if [ $# -lt 4  ] ; then
		echo "bm_set_ip net_device ip netmask gateway dns to to_netmask via table rule_from rule_from_mask rule_to rule_to_mask"
		echo "eg: bm_set_ip eth0 192.168.1.100 255.255.255.0 192.168.1.1 192.168.1.1 192.168.2.0 255.255.255.0 192.168.1.1"
		echo "gateway and dns allow empty. pls follow below example"
		echo "eg: bm_set_ip eth0 192.168.1.100 255.255.255.0 '' '' "
		echo "Restoring default netplan configuration"
		echo "eg: bm_set_ip default "
		echo " to: destination network, via: next hop address, table: Routing Table ID, rule_from/rule_to: routing-policy"
		exit -1
	fi
fi


device=$1
ip=$2
netmask=$3
if [ $netmask = "0.0.0.0" ]; then
        exit -1
fi
gateway=$4
dns=$5

to_net=$6
to_netmask=$7
via=$8
table=$9
rule_from=${10}
rule_from_mask=${11}
rule_to=${12}
rule_to_mask=${13}

# Function: Convert netmask to CIDR format
netmask_to_cidr() {
    local netmask=$1
    local shortMask=0
    local maskArray=()

    # Split netmask into an array
    local mask1=$(echo $netmask | awk -F . '{printf("%d\n", $1)}')
    local mask2=$(echo $netmask | awk -F . '{printf("%d\n", $2)}')
    local mask3=$(echo $netmask | awk -F . '{printf("%d\n", $3)}')
    local mask4=$(echo $netmask | awk -F . '{printf("%d\n", $4)}')
    maskArray=($mask1 $mask2 $mask3 $mask4)

    # Calculate CIDR prefix length
    for (( i=0; i<${#maskArray[@]}; i++ )); do
        if [ "${maskArray[$i]}" = "255" ]; then
            shortMask=$((shortMask + 8))
        else
            local lastBin=$(echo "obase=2; ${maskArray[$i]}" | bc)
            local last=$(echo $lastBin | grep -o '1' | wc -l)
            shortMask=$((shortMask + last))
            break
        fi
    done

    echo $shortMask
}

shortMask=$(netmask_to_cidr $netmask)
to_shortMask=$(netmask_to_cidr $to_netmask)
rule_from_shortMask=$(netmask_to_cidr $rule_from_mask)
rule_to_shortMask=$(netmask_to_cidr $rule_to_mask)

is_ubuntu=$(cat /etc/os-release | grep Ubuntu |wc -l)
is_kylinos=$(cat /etc/os-release | grep kylinos |wc -l)

if [ $is_ubuntu -gt 1 ];then
	echo "ubuntu"
	device_path="/etc/netplan/01-netcfg.yaml"
	#device_path="01-netcfg.yaml"
	# Build the whole new file content in a local temp file and swap it into place
	# with a single atomic "mv" at the end, instead of many separate "sudo tee -a"
	# appends straight to the live netplan file. The previous incremental-append
	# approach left the live file in syntactically-incomplete states (e.g. a
	# "nameservers:" line written before its nested "addresses:" line landed) for
	# the whole duration of the script, and netplan's own file-change watcher would
	# occasionally parse the file in one of those half-written states and fail with
	# "expected mapping (check indentation)". Writing to a temp file first and
	# swapping it in means any watcher only ever sees the complete old file or the
	# complete new one.
	tmp_path=$(mktemp)

	# Strip any existing config block for this device by indentation, not by a
	# fixed line-count guess: a fixed-offset scan could leave duplicate
	# "$device:" blocks behind whenever the block's shape didn't match the
	# assumed layout, which in turn made a later grep for "$device:" match more
	# than once and broke arithmetic that used to rely on there being exactly one.
	awk -v dev="${device}:" '
		{
			line = $0
			content = line
			sub(/^[ \t]*/, "", content)
			match(line, /^[ \t]*/)
			indent = RLENGTH
			if (skip && indent <= dev_indent) { skip = 0 }
			if (!skip && content == dev) { skip = 1; dev_indent = indent; next }
			if (skip) next
			print line
		}
	' "$device_path" > "$tmp_path"

	echo "add network config"
	{
		echo "                ${device}:"
		echo "                        dhcp4: no"
		echo "                        addresses: [${ip}/${shortMask}]"
		echo "                        nameservers:"
		echo "                                addresses: [${dns}]"

		# gateway4 is deprecated by netplan -- use a default route instead. eth0's
		# default route gets metric 200 so it's less preferred than eth1's, which
		# keeps the (unset) default metric.
		default_route=0
		if [ "$gateway" != "" ] && [[ "$device" == "enp3s0" || "$device" == "enp4s0" || "$device" == "eth0" || "$device" == "eth1" ]];then
			default_route=1
		fi
		static_route=0
		if [ "$to_net" != "" ] && [ "$to_netmask" != "" ] && [ "$via" != "" ]; then
			static_route=1
		fi
		if [ "$default_route" -eq 1 ] || [ "$static_route" -eq 1 ]; then
			echo "                        routes:"
			if [ "$default_route" -eq 1 ]; then
				echo "                                - to: default"
				echo "                                  via: ${gateway}"
				if [ "$device" == "eth0" ]; then
					echo "                                  metric: 200"
				fi
			fi
			if [ "$static_route" -eq 1 ]; then
				echo "                                - to: ${to_net}/${to_shortMask}"
				echo "                                  via: ${via}"
				echo "                                  table: ${table}"
			fi
		fi
		if [ "$rule_to" != "" ] || [ "$rule_from" != "" ]; then
			echo "                        routing-policy:"
		fi
		if [ "$rule_to" != "" ] && [ "$rule_to_mask" != "" ]; then
			echo "                                - to: ${rule_to}/${rule_to_shortMask}"
			echo "                                  table: ${table}"
		elif [ "$rule_to" != "" ] && [ "$rule_to_mask" == "" ]; then
			echo "                                - to: ${rule_to}"
			echo "                                  table: ${table}"
		fi
		if [ "$rule_from" != "" ] && [ "$rule_from_mask" != "" ]; then
			echo "                                - from: ${rule_from}/${rule_from_shortMask}"
			echo "                                  table: ${table}"
		elif [ "$rule_from" != "" ] && [ "$rule_from_mask" == "" ]; then
			echo "                                - from: ${rule_from}"
			echo "                                  table: ${table}"
		fi
		echo "                        optional: yes"
	} | tee -a "$tmp_path"

	sudo cp "$tmp_path" "${device_path}.new"
	sudo chmod 600 "${device_path}.new"
	sudo mv "${device_path}.new" "$device_path"
	rm -f "$tmp_path"
	sudo sync
	sudo netplan apply

else
	if [ $is_kylinos -gt 1 ];then
		exist=$(nmcli con | grep "static-${device}" | wc -l)
		if [ "$exist" -gt 0 ]; then
			nmcli con delete "static-${device}"
		fi
		nmcli con add type ethernet con-name "static-${device}" ifname ${device} ipv4.method manual ipv4.addresses ${ip}/${shortMask}
		if [ "$gateway" != "" ] && [ "$device" == "enp3s0" ];then
			nmcli con modify "static-${device}" ipv4.gateway $gateway
		fi
		if [ "$dns" != "" ];then
			nmcli con modify "static-${device}" ipv4.dns $dns
		fi
		nmcli connection modify "static-${device}" connection.autoconnect yes
		nmcli con up "static-${device}"
	else
		echo "debian"
		device_path="/etc/network/interfaces.d/$device"

		echo  "auto $device" | sudo tee $device_path
		echo  "iface $device inet static" |sudo tee -a $device_path
		echo  "        address $ip" |sudo tee -a $device_path
		echo  "        netmask $netmask" |sudo tee -a $device_path
		if [ $device == "eth0"  ];then
			echo  "        gateway $gateway" |sudo tee -a $device_path
		fi
		echo "        dns-nameservers $dns" |sudo tee -a $device_path

		sudo ip addr flush dev $device
		sudo service networking restart
	fi
fi
